{
  "expo": {
    "name": "Lianebi",
    "slug": "lianebi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lianebi",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lionfromrustavi.boltexponativewind"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": ["expo-router", "expo-font", "expo-web-browser"],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.lionfromrustavi.boltexponativewind"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "688843b0-9e8c-4611-98b7-6792ab127313"
      }
    }
  }
}
